# Vorlage: Kopiere diese Datei zu "keystore.properties" und trage deine Werte ein.
# keystore.properties wird NICHT ins Git eingecheckt (steht in .gitignore).

# Pfad zum Keystore – relativ zum Projektordner oder absolut
PLANIT_STORE_FILE=./planit-release.keystore

# Passwörter und Alias
PLANIT_STORE_PASSWORD=DEIN_STORE_PASSWORT
PLANIT_KEY_ALIAS=planit
PLANIT_KEY_PASSWORD=DEIN_KEY_PASSWORT
